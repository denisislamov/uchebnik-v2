{
  "name": "arithmetic-first-steps",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "assets": "python3 scripts/prepare_assets.py",
    "format": "prettier --write App.tsx index.ts src tests scripts/browser-smoke.cjs",
    "test:content": "python3 scripts/content/extract.py --check && python3 scripts/content/build_course.py --check",
    "test:browser": "node scripts/run-browser-tests.cjs",
    "test:all": "npm run test:content && npm run typecheck && npm test && npm run test:release-guard && npm run export:web && npm run test:browser",
    "web:debug": "node scripts/start-source-debug.cjs",
    "test:debug": "node scripts/debug-source-smoke.cjs",
    "test:release-guard": "node scripts/check-release-debug-guard.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.4",
    "expo-font": "~57.0.0",
    "expo-speech": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.4",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}

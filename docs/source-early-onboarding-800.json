        {
          "index": 3,
          "text": "Отвечай на вопросы по очереди. Для каждого вопроса сосчитай нужные предметы и запиши ответ.",
          "card": {
            "x": 216,
            "y": 20,
            "width": 368,
            "height": 343
          },
          "hole": null,
          "finger": null,
          "surface": null,
